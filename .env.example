# Copie para .env.local e preencha com os dados do projeto no supabase.com
# (Project Settings → API). NUNCA coloque a service_role em variável NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (vai dentro do QR code dos ônibus).
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
